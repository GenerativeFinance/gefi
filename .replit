modules = ["nodejs-20", "web", "ruby-3.2", "python-3.11"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Playground (manual start)"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bundle config set --local path 'vendor/bundle' && bundle install && bundle exec jekyll serve --host 0.0.0.0 --port 5000 --livereload --livereload-port 35730"
waitForPort = 5000

[[workflows.workflow]]
name = "Playground (manual start)"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd playground && pnpm install --prefer-offline --silent && pnpm run dev"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 4000
externalPort = 5173

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8787
externalPort = 4200

[[ports]]
localPort = 24678
externalPort = 3001

[deployment]
deploymentTarget = "autoscale"
run = ["node", "dist/index.js"]
build = ["npm", "run", "build"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
