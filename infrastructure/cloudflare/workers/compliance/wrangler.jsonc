{
  "$schema": "node_modules/wrangler/config-schema.json",
  // gefi-compliance is an internal Worker exposed only via Service binding
  // from gefi-api (no public route). It owns the audit log table and the
  // jurisdiction-rule cache. Real rule logic lands in Task #4 — for the
  // foundation we ship the binding, /health, and a stubbed /audit/append.
  "name": "gefi-compliance",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": false,
  "vars": {
    "ENVIRONMENT": "dev",
    "WORKER_REGION": "us",
    "API_PUBLIC_URL": "http://localhost:8787",
    "SITE_PUBLIC_URL": "http://localhost:8788"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "gefi-compliance-dev", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "r2_buckets": [
    { "binding": "EVIDENCE", "bucket_name": "gefi-evidence-dev" }
  ],
  "kv_namespaces": [
    { "binding": "CACHE", "id": "00000000000000000000000000000000" }
  ],
  "env": {
    "staging": {
      "vars": {
        "ENVIRONMENT": "staging",
        "WORKER_REGION": "us",
        "API_PUBLIC_URL": "https://staging-api.gefi.io",
        "SITE_PUBLIC_URL": "https://staging.gefi.io"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "gefi-compliance-staging", "database_id": "REPLACE_WITH_STAGING_DB_ID" }
      ],
      "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "gefi-evidence-staging" }],
      "kv_namespaces": [{ "binding": "CACHE", "id": "REPLACE_WITH_STAGING_KV_ID" }]
    },
    "prod": {
      "vars": {
        "ENVIRONMENT": "prod",
        "WORKER_REGION": "us",
        "API_PUBLIC_URL": "https://api.gefi.io",
        "SITE_PUBLIC_URL": "https://gefi.io"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "gefi-compliance-prod", "database_id": "REPLACE_WITH_PROD_DB_ID" }
      ],
      "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "gefi-evidence-prod" }],
      "kv_namespaces": [{ "binding": "CACHE", "id": "REPLACE_WITH_PROD_KV_ID" }]
    }
  }
}
