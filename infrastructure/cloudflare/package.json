{
  "name": "gefi-cloudflare",
  "private": true,
  "version": "0.1.0",
  "description": "Cloudflare backend foundation for GeFi.io — three Workers (gefi-web, gefi-api, gefi-compliance) plus shared packages.",
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:staging": "turbo run deploy -- --env staging",
    "deploy:prod": "turbo run deploy -- --env prod"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240620.0",
    "turbo": "^2.0.6",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0",
    "wrangler": "^3.62.0"
  }
}
