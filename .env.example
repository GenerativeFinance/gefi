# Environment variables for GeFi Report Generation

# Database (required)
DATABASE_URL=your-neon-database-url

# Redis for BullMQ job queue (optional - will gracefully fail if not available)
REDIS_URL=redis://localhost:6379

# S3 for PDF storage (optional - will fallback to local storage)
S3_BUCKET=your-s3-bucket-name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Development
VITE_SKIP_SOURCE_MAP=true
NODE_ENV=development